# CareGuard Environment Variables

# App settings
APP_ENV=development
SECRET_KEY=careguard_super_secret_jwt_key_change_in_production_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./careguard.db

# MQTT Broker Settings
# Use HiveMQ free public broker, HiveMQ Cloud, or local Mosquitto
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=careguard_backend_server
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_TOPIC_PREFIX=careguard

# Real Alert Flags (CRITICAL GUARDRAIL)
# Set to true ONLY to enable real outbound SMS/Calls and emergency notifications
ENABLE_REAL_ALERTS=false

# Notification Provider: mock | twilio | msg91
NOTIFICATION_PROVIDER=mock

# Twilio Settings (if NOTIFICATION_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# MSG91 Settings (if NOTIFICATION_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Emergency Service Configuration
EMERGENCY_NUMBER_POLICE=112
EMERGENCY_NUMBER_AMBULANCE=108
DEFAULT_HOSPITAL_PHONE=+919876543210
